<%= form_with model: book do |form| %>

  <% if book.errors.any? %>
    <div class="error-message">
      <h3>入力内容にエラーがあります</h3>

      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div class="form-group">
    <%= form.label :author, "著者" %>
    <%= form.text_field :author %>
  </div>

  <div class="form-group">
    <%= form.label :memo, "メモ" %>
    <%= form.text_area :memo %>
  </div>

  <div>
    <%= form.submit %>
  </div>

<% end %>