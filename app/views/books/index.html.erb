<h2>本一覧</h2>

<%= link_to "新しい本を登録", new_book_path, class: "button" %>

<div class="book-list">

  <% @books.each do |book| %>

    <div class="book-card">

      <h3><%= book.title %></h3>

      <p>
        著者：
        <%= book.author %>
      </p>

      <p>
        <%= link_to "詳細", book_path(book) %>
        <%= link_to "編集", edit_book_path(book) %>

        <%= link_to "削除",
                    book_path(book),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "本当に削除しますか？"
                    } %>
      </p>

    </div>

  <% end %>

</div>